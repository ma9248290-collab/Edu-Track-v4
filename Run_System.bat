@echo off
:: تغيير الكود ليدعم اللغة العربية في الشاشة السوداء
chcp 65001 > nul
title EduTrack System - Smart Assistant
color 0b

echo.
echo  ================================================
echo        جاري تشغيل نظام EduTrack الذكي... 🚀
echo  ================================================
echo.

:: تشغيل السيرفر في وضع مخفي (Minimzed)
echo [1/2] جاري ربط قاعدة البيانات والذكاء الاصطناعي...
start /min node server.js

:: الانتظار 3 ثواني للتأكد إن السيرفر قام
timeout /t 3 /nobreak > nul

:: فتح واجهة المستخدم في المتصفح
echo [2/2] جاري فتح لوحة التحكم...
start "" "index.html"

echo.
echo ✅ السيستم يعمل الآن بنجاح!
echo 💡 لا تغلق هذه النافذة إلا عند الانتهاء من العمل.
echo.
pause